# Backend base URL
VITE_API_BASE_URL=http://localhost:8081

# true: sử dụng dữ liệu mock
# false: gọi backend thật
VITE_USE_MOCK_API=true

# --- Authentication (Keycloak) ---
# Keycloak server base URL (not the backend's own base URL above).
VITE_KEYCLOAK_BASE_URL=http://localhost:8080

# FOR LOCAL DEVELOPMENT ONLY: the browser is always on localhost, so there is
# no real hostname to resolve a tenant from. This is purely a lookup key sent
# to GET /api/v1/tenants/login-info?domain=... — it never needs to actually
# resolve in DNS. Set it to whatever domainUrl you gave the tenant when
# onboarding it (POST /api/v1/tenants), and change it to test a different
# tenant locally. Ignored once the app is actually deployed under a real
# hostname.
VITE_DEV_TENANT_DOMAIN=acme.ecofood.local

# Idle-timeout warning, in seconds (defaults: 900s / 30s if unset).
VITE_IDLE_SECONDS=900
VITE_IDLE_COUNTDOWN_SECONDS=30